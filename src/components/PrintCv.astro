---
// Print-first version of the CV: same data as the screen page, laid out as an A4 document.
// Used by /print, and embedded (print-only) in the screen page so any way of printing it gets this layout.
import { Image } from "astro:assets";
import ava from "@/assets/ava.png";
import Bio from "@/assets/bio.md";
import { MY_DETAILS } from "@/assets/MyDetails";
import { MY_PROJECTS } from "@/assets/MyProjects";
import { MY_SKILLS } from "@/assets/MySkills";
import { MY_TIMELINE_ENTRIES } from "@/assets/MyTimeline";
import { displayUrl } from "@/utils/displayUrl";
import { formatRolesYears, formatYears } from "@/utils/formatYears";
import { ROLE_CHANGE_LABELS } from "@/utils/roleChanges";

const { name, year, location, school, degree, languages, linkedinHref, githubHref } = MY_DETAILS;

const siteHref = Astro.site?.href;
const contacts = [siteHref, linkedinHref, githubHref].filter((href) => href !== undefined);
const locationLine = [location, year && `Born ${year}`].filter(Boolean).join(" · ");
const updated = new Date().toLocaleDateString("en-GB", { month: "long", year: "numeric" });
---

<main
    class="cv mx-auto mb-8 w-[210mm] max-w-full min-h-[297mm] bg-white px-[16mm] py-[14mm] shadow-lg print:m-0 print:w-auto print:min-h-0 print:p-0 print:shadow-none"
>
    <header class="flex items-start justify-between gap-6 pb-4 border-b border-neutral-300">
        <div>
            <h1 class="text-[22pt] font-semibold leading-tight tracking-tight">{name}</h1>
            <div class="mt-1 muted">
                <p>{locationLine}</p>
                <p>{[school, degree].filter(Boolean).join(", ")}</p>
                <p>{languages.join(", ")}</p>
            </div>
            <p class="mt-1">
                {
                    contacts.map((href, i) => (
                        <>
                            {i > 0 && <span class="muted"> · </span>}
                            <a href={href}>{displayUrl(href)}</a>
                        </>
                    ))
                }
            </p>
        </div>
        <!-- eager: on the screen page this sits in a hidden container, where a lazy image would never load -->
        <Image src={ava} alt={name} width={200} loading="eager" class="size-[24mm] shrink-0 rounded-full object-cover" />
    </header>

    <section>
        <h2>Summary</h2>
        <div class="summary">
            <Bio />
        </div>
    </section>

    <section>
        <h2>Skills</h2>
        <dl class="grid grid-cols-[34mm_1fr] gap-x-4 gap-y-1">
            {
                MY_SKILLS.map(({ title, items }) => (
                    <>
                        <dt class="font-medium">{title}</dt>
                        <dd>{items.map((item) => item.title).join(", ")}</dd>
                    </>
                ))
            }
        </dl>
    </section>

    <section>
        <h2>Experience</h2>
        {
            MY_TIMELINE_ENTRIES.map(({ company, companyNote, roles }) => (
                <article class="mb-4 last:mb-0">
                    <div class="break-after-avoid">
                        <h3 class="text-[11pt] font-semibold">
                            {company}
                            {companyNote && <span class="font-normal muted"> ({companyNote})</span>}
                        </h3>
                        {roles.length > 1 && <div class="muted tabular-nums">{formatRolesYears(roles)}</div>}
                    </div>
                    {roles.map((role, i) => (
                        <div
                            class:list={[
                                "role break-inside-avoid mt-1.5",
                                roles.length > 1 && "ps-3 border-s-2 border-neutral-200",
                            ]}
                        >
                            <h4 class="font-medium">
                                {role.title}
                                {role.change && <span class="change">{ROLE_CHANGE_LABELS[role.change]}</span>}
                            </h4>
                            <div class="muted tabular-nums">
                                {formatYears(role.yearStart, role.yearEnd, role.ongoing)} · {role.location}
                            </div>
                            <p>{role.description.trim()}</p>
                            {role.technologies && (
                                <p class="muted">
                                    {i === roles.length - 1 ? "Tech" : "New tech"}: {role.technologies.join(", ")}
                                </p>
                            )}
                        </div>
                    ))}
                </article>
            ))
        }
    </section>

    <section>
        <h2>Pet projects</h2>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5">
            {
                MY_PROJECTS.map(({ name, href, description, yearStart, yearEnd, technologies }) => (
                    <li class="break-inside-avoid">
                        <h3 class="font-medium">
                            {name}
                            <span class="font-normal muted"> · {formatYears(yearStart, yearEnd)}</span>
                        </h3>
                        <div class="muted">
                            <a href={href}>{displayUrl(href)}</a>
                            {technologies && ` · ${technologies.join(", ")}`}
                        </div>
                        <p>{description}</p>
                    </li>
                ))
            }
        </ul>
    </section>

    {
        siteHref && (
            <footer class="mt-6 pt-2 border-t border-neutral-300 muted text-[8pt] flex justify-between">
                <span>
                    Interactive version: <a href={siteHref}>{displayUrl(siteHref)}</a>
                </span>
                <span>Updated {updated}</span>
            </footer>
        )
    }
</main>

<style is:global>
    @page {
        size: A4;
        margin: 14mm 16mm;
    }

    @media print {
        /* the screen page may be in dark mode; paper is always light */
        html,
        body {
            color-scheme: light;
            background: white !important;
        }
    }
</style>

<style>
    .cv {
        color: #1f2328;
        font-size: 9.5pt;
        line-height: 1.45;
    }

    .muted {
        color: #5b636e;
    }

    /* global so it also reaches links rendered by bio.md */
    .cv :global(a) {
        color: #0b57d0;
        text-decoration: underline;
        text-underline-offset: 0.15em;
    }

    section {
        margin-top: 5mm;
    }

    h2 {
        margin-bottom: 2mm;
        padding-bottom: 1mm;
        border-bottom: 1px solid #d0d4d9;
        color: #1d4f7a;
        font-size: 9pt;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        break-after: avoid;
    }

    .change {
        margin-inline-start: 0.6em;
        color: #1d4f7a;
        font-size: 7.5pt;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .role p {
        margin-top: 0.5mm;
    }

    .summary :global(p) {
        margin-bottom: 1.5mm;
    }

    /* the link text isn't a URL, so on paper it's just emphasis */
    .summary :global(a) {
        color: inherit;
        font-weight: 600;
        text-decoration: none;
    }

    /* jumps within the screen page mean nothing on paper */
    .summary :global(a[href^="#"]) {
        font-weight: inherit;
    }
</style>
