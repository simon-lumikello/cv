---
import {
  Baby,
  GraduationCap,
  Languages,
  MapPinned,
  Link,
} from "@lucide/astro";
import { Image } from "astro:assets";
import ava from "@/assets/ava.png";
import type { PersonDetails } from "@/types/PersonDetails";
import PrintButton from "@/components/PrintButton.astro";
import SummaryPoint from "@/components/SummaryPoint.astro";

interface Props {
  details: PersonDetails;
}

const { details } = Astro.props;
const { name, location, year, school, degree, languages, linkedinHref, githubHref } = details;
---

<!-- same width as the bio and skills below, so the page reads as one column -->
<div class="card bg-base-200 w-full md:w-3/4 max-w-[65ch] shadow-md">
  <!--
    from sm up: photo with the print button under it, details beside both;
    on phones the source order applies: photo, details, print button
  -->
  <div class="card-body grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-x-8 gap-y-4 sm:gap-y-3">
    <!-- daisyUI's avatar centres itself, so the top alignment has to be set on it directly -->
    <figure class="avatar hover-3d justify-self-center sm:self-start">
      <div class="mask mask-hexagon-2 w-40">
        <Image src={ava} alt={name} fetchpriority="high" priority />
      </div>
    </figure>

    <div class="flex flex-col gap-2 sm:row-span-2">
      <h1 class="text-2xl font-light mb-1 text-center sm:text-start">{name}</h1>
      {year && (
        <SummaryPoint text={`${year}`}><Baby slot="icon" /></SummaryPoint>
      )}

      <SummaryPoint text={location}>
        <MapPinned slot="icon" />
      </SummaryPoint>

      <SummaryPoint text={degree ? [school, degree] : school}>
        <GraduationCap slot="icon" />
      </SummaryPoint>

      <SummaryPoint text={languages.join(", ")}>
        <Languages slot="icon" />
      </SummaryPoint>

      {
        (linkedinHref || githubHref) && (
          <SummaryPoint>
            <Link slot="icon" />
            {linkedinHref && <a class="link link-hover" href={linkedinHref}>LinkedIn</a>}
            {linkedinHref && githubHref && <span class="opacity-50"> · </span>}
            {githubHref && <a class="link link-hover" href={githubHref}>GitHub</a>}
          </SummaryPoint>
        )
      }
    </div>

    <!-- as wide as the photo from sm up, so it reads as a block under it rather than a caption -->
    <PrintButton class="justify-self-start sm:w-40 sm:self-start" />
  </div>
</div>
