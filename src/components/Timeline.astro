<!--
    daisyUI's snap-icon rule overrides compact's empty first column (same specificity, later in the stylesheet),
    so the compact layout is restored with a utility; the oldest entry ends the line at its marker
-->
<ul
    class="timeline timeline-snap-icon timeline-compact timeline-vertical px-4 *:[--timeline-col-start:0] [&>li:last-child>hr]:hidden"
>
    <slot />
</ul>
