---
import { Image } from "astro:assets";
import type { PetProject } from "@/types/PetProject";
import { displayUrl } from "@/utils/displayUrl";
import { formatYears } from "@/utils/formatYears";
import { slug } from "@/utils/slug";

interface Props extends PetProject {}

const { name, href, hrefLabel, description, yearStart, yearEnd, technologies } = Astro.props;

// written by `bun run screenshots`; a project without one renders as a plain card.
// It goes under the content, after the card body's bottom padding, fading in from the card body and
// clipped by the card's rounded bottom corners.
const screenshots = import.meta.glob<ImageMetadata>("/src/assets/projects/*.jpg", { eager: true, import: "default" });
const screenshot = screenshots[`/src/assets/projects/${slug(name)}.jpg`];
---

<div class="card bg-base-200 card-frame overflow-hidden group">
    <div class="card-body gap-3">
        <div>
            <div class="flex items-baseline justify-between gap-3">
                <h3 class="card-title text-xl font-medium">{name}</h3>
                <time class="text-subtle not-italic font-mono">{formatYears(yearStart, yearEnd)}</time>
            </div>
            <a class="link link-hover text-sm text-base-content/70" href={href}>{hrefLabel ?? displayUrl(href)}</a>
        </div>
        <p>{description}</p>
        {
            technologies && (
                <div class="flex flex-wrap gap-1.5 mt-auto">
                    {technologies.map((tech) => (
                        <span class="badge badge-sm badge-soft">{tech}</span>
                    ))}
                </div>
            )
        }
    </div>
    {
        screenshot && (
            <a href={href} tabindex="-1" aria-hidden="true" class="shot block">
                <Image
                    src={screenshot}
                    alt=""
                    widths={[480, 960]}
                    sizes="(min-width: 1280px) 30vw, (min-width: 768px) 40vw, 100vw"
                    class="w-full aspect-[16/10] object-cover object-top transition-transform duration-500 motion-safe:group-hover:scale-[1.03]"
                />
            </a>
        )
    }
</div>

<style>
    /* smoothstep easing over the top 60%: a linear fade shows a hard edge where it starts and ends */
    .shot {
        mask-image: linear-gradient(
            to bottom,
            rgb(0 0 0 / 0) 0%,
            rgb(0 0 0 / 0.028) 6%,
            rgb(0 0 0 / 0.104) 12%,
            rgb(0 0 0 / 0.216) 18%,
            rgb(0 0 0 / 0.352) 24%,
            rgb(0 0 0 / 0.5) 30%,
            rgb(0 0 0 / 0.648) 36%,
            rgb(0 0 0 / 0.784) 42%,
            rgb(0 0 0 / 0.896) 48%,
            rgb(0 0 0 / 0.972) 54%,
            #000 60%
        );
    }
</style>
