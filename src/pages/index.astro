---
import "@/styles/global.css";
import { Link2 } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Bio from "@/assets/bio.md";
import { MY_DETAILS } from "@/assets/MyDetails";
import { MY_SKILLS } from "@/assets/MySkills";
import { MY_TIMELINE_ENTRIES } from "@/assets/MyTimeline";
import DetailsCard from "@/components/DetailsCard.astro";
import SkillsSummary from "@/components/SkillsSummary.astro";
import SummaryPoint from "@/components/SummaryPoint.astro";
import Timeline from "@/components/Timeline.astro";
import TimelineItem from "@/components/TimelineItem.astro";
import { MY_PROJECTS } from "@/assets/MyProjects";
import ProjectCard from "@/components/ProjectCard.astro";
---

<Layout>
    <div class="flex flex-col items-center gap-10 pt-8 px-4">
        <!-- Details -->
        <DetailsCard details={MY_DETAILS} />

        <!-- Bio -->
        <article class="prose prose-slate w-full md:w-3/4">
            <Bio />
        </article>

        <!-- Stack -->
        <h2 class="text-2xl font-light">Skills</h2>
        <SkillsSummary skillGroups={MY_SKILLS} />

        <!-- Timeline -->
        <h2 class="text-2xl font-light">Experience</h2>
        <Timeline>
            {MY_TIMELINE_ENTRIES.map((entry) => <TimelineItem {...entry} />)}
        </Timeline>

        <!-- Pet projects -->
        <h2 id="pet-projects" class="text-2xl font-light scroll-mt-8">Pet projects</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 w-full md:w-3/4">
            {MY_PROJECTS.map((entry) => <ProjectCard {...entry} />)}
        </div>

        <!-- Github -->
        {
            MY_DETAILS.repoHref && (
                <a href={MY_DETAILS.repoHref} class="text-subtle mb-4">
                    <SummaryPoint text="This page on GitHub">
                        <Link2 slot="icon" />
                    </SummaryPoint>
                </a>
            )
        }
    </div>
</Layout>
